def build_notepadabc(env, build_type, target_arch, scintilla_lib, lexilla_lib):
    """构建Notepad_abc主程序"""
    
    print("构建Notepad_abc主程序...")
    
    # 获取源文件和资源文件
    source_files = get_notepadabc_source_files()
    rc_files = get_notepadabc_resource_files()
    
    # 编译资源文件
    rc_objects = []
    for rc_file in rc_files:
        rc_obj = env.RES(rc_file)
        rc_objects.append(rc_obj)
    
    # 添加依赖库
    if scintilla_lib:
        env.Append(LIBS=['scintilla.lib'])
    if lexilla_lib:
        env.Append(LIBS=['lexilla.lib'])
    
    # 设置目标文件名
    target_name = 'notepad_abc.exe'
    
    # 构建程序
    program = env.Program(
        target=target_name,
        source=source_files + rc_objects
    )
    
    # 复制到bin目录
    env.Install(bin_dir, program)
    
    print(f"Notepad_abc主程序构建完成: {len(source_files)} 个源文件, {len(rc_files)} 个资源文件")
    return program

