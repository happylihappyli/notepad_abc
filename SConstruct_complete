def configure_environment(build_type='Release', target_arch='x86_64'):
    """配置SCons构建环境"""
    
    # 创建环境
    env = Environment(
        ENV = os.environ,
        TARGET_ARCH = target_arch,
        MSVC_VERSION = '14.3',  # VS2022
        MSVS_VERSION = '2022'
    )
    
    # 设置编码为UTF-8
    env['ENV']['PYTHONIOENCODING'] = 'utf-8'
    
    # 配置编译器选项
    env = configure_compiler_options(env, build_type, target_arch)
    
    # 配置链接器选项
    env = configure_linker_options(env, build_type, target_arch)
    
    return env

def configure_compiler_options(env, build_type, target_arch):
    """配置编译器选项"""
    
    # 基本编译器标志
    cxxflags = [
        '/std:c++20',           # C++20标准
        '/MP',                   # 多处理器编译
        '/W4',                   # 警告级别4
        '/WX',                   # 将警告视为错误
        '/Zc:wchar_t',           # wchar_t是本机类型
        '/Zc:forScope',          # 强制for循环范围
        '/Zc:inline',            # 移除未引用的函数
        '/permissive-',          # 严格标准一致性
        '/utf-8',                # UTF-8编码
    ]
    
    # 根据架构调整
    if target_arch == 'ARM64':
        cxxflags.append('/ARM64')
    elif target_arch == 'Win32':
        cxxflags.append('/arch:SSE2')
    elif target_arch == 'x64':
        cxxflags.append('/favor:AMD64')
    
    # 预处理器定义
    defines = [
        'WIN32',
        '_WINDOWS',
        'UNICODE',
        '_UNICODE',
        '_WIN32_WINNT=0x0601',   # Windows 7
        'WINVER=0x0601',         # Windows 7
        '_CRT_SECURE_NO_WARNINGS',
        '_SCL_SECURE_NO_WARNINGS',
        'NOMINMAX',
        'STRICT',
        'TIXML_USE_STL',
        'NOTEPADPLUS_VERSION="8.6.6"',
    ]
    
    # 根据构建类型添加定义
    if build_type == 'Debug':
        defines.extend([
            'DEBUG',
            '_DEBUG',
        ])
        cxxflags.extend([
            '/Od',                # 禁用优化
            '/RTC1',              # 运行时检查
            '/ZI',                # 编辑并继续调试信息
            '/JMC',               # 仅我的代码调试
        ])
    else:  # Release
        defines.extend([
            'NDEBUG',
        ])
        cxxflags.extend([
            '/O2',                # 最大优化速度
            '/Ob2',               # 内联任何合适的函数
            '/Oi',                # 生成内部函数
            '/Ot',                # 偏好快速代码
            '/GL',                # 全程序优化
            '/Gy',                # 函数级链接
        ])
    
    env.Append(CCFLAGS=cxxflags)
    env.Append(CPPDEFINES=defines)
    
    # 包含目录
    include_dirs = [
        src_dir,
        os.path.join(src_dir, 'TinyXml'),
        os.path.join(src_dir, 'TinyXml', 'tinyXmlA'),
        os.path.join(src_dir, 'uchardet'),
        os.path.join(scintilla_dir, 'include'),
        os.path.join(lexilla_dir, 'include'),
        os.path.join(scintilla_dir, 'src'),
        os.path.join(lexilla_dir, 'src'),
    ]
    
    # 添加WinControls子目录
    wincontrols_base = os.path.join(src_dir, 'WinControls')
    if os.path.exists(wincontrols_base):
        for item in os.listdir(wincontrols_base):
            item_path = os.path.join(wincontrols_base, item)
            if os.path.isdir(item_path):
                include_dirs.append(item_path)
    
    env.Append(CPPPATH=include_dirs)
    
    return env

def configure_linker_options(env, build_type, target_arch):
    """配置链接器选项"""
    
    # 基本链接器标志
    linkflags = [
        '/MANIFEST',             # 生成清单
        '/MANIFESTUAC:level=\'asInvoker\' uiAccess=\'false\'',
        '/DYNAMICBASE',          # ASLR支持
        '/NXCOMPAT',             # 数据执行保护
        '/SUBSYSTEM:WINDOWS',    # Windows子系统
        '/OPT:REF',              # 移除未引用数据
        '/OPT:ICF',              # 相同COMDAT折叠
    ]
    
    # 根据架构调整
    if target_arch == 'ARM64':
        linkflags.append('/MACHINE:ARM64')
    elif target_arch == 'Win32':
        linkflags.append('/MACHINE:X86')
    elif target_arch == 'x64':
        linkflags.append('/MACHINE:X64')
    
    # 根据构建类型配置
    if build_type == 'Debug':
        linkflags.extend([
            '/DEBUG',             # 生成调试信息
            '/INCREMENTAL',       # 增量链接
        ])
    else:  # Release
        linkflags.extend([
            '/LTCG',              # 链接时代码生成
        ])
    
    env.Append(LINKFLAGS=linkflags)
    
    # 库文件
    libraries = [
        'kernel32.lib',
        'user32.lib',
        'gdi32.lib',
        'winspool.lib',
        'comdlg32.lib',
        'advapi32.lib',
        'shell32.lib',
        'ole32.lib',
        'oleaut32.lib',
        'uuid.lib',
        'odbc32.lib',
        'odbccp32.lib',
        'comctl32.lib',
        'shlwapi.lib',
        'version.lib',
        'imm32.lib',
        'winmm.lib',
        'usp10.lib',
        'dwmapi.lib',
    ]
    
    env.Append(LIBS=libraries)
    
    # 库目录
    lib_dirs = [
        os.path.join(scintilla_dir, 'bin'),
        os.path.join(lexilla_dir, 'bin'),
    ]
    
    env.Append(LIBPATH=lib_dirs)
    
    return env

