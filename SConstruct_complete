def build_scintilla(env, build_type, target_arch):
    """构建Scintilla库"""
    
    print("构建Scintilla库...")
    
    # Scintilla源文件
    scintilla_src_dir = os.path.join(scintilla_dir, 'src')
    scintilla_sources = []
    
    if os.path.exists(scintilla_src_dir):
        for root, dirs, files in os.walk(scintilla_src_dir):
            for file in files:
                if file.endswith('.cxx') or file.endswith('.cpp'):
                    scintilla_sources.append(os.path.join(root, file))
    
    # Windows平台特定文件
    win32_dir = os.path.join(scintilla_dir, 'win32')
    if os.path.exists(win32_dir):
        for root, dirs, files in os.walk(win32_dir):
            for file in files:
                if file.endswith('.cxx') or file.endswith('.cpp'):
                    scintilla_sources.append(os.path.join(root, file))
    
    if not scintilla_sources:
        print("警告: 未找到Scintilla源文件，跳过构建")
        return None
    
    # 构建Scintilla库
    scintilla_lib = env.StaticLibrary(
        target='scintilla.lib',
        source=scintilla_sources
    )
    
    # 复制到bin目录
    scintilla_bin_dir = os.path.join(scintilla_dir, 'bin')
    if not os.path.exists(scintilla_bin_dir):
        os.makedirs(scintilla_bin_dir)
    
    env.Install(scintilla_bin_dir, scintilla_lib)
    
    print(f"Scintilla库构建完成: {len(scintilla_sources)} 个源文件")
    return scintilla_lib

