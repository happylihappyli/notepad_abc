def main():
    """主构建函数"""
    
    print("=" * 70)
    print("Notepad_abc完整构建系统")
    print("基于Visual Studio解决方案")
    print("=" * 70)
    
    # 获取构建参数
    build_type = ARGUMENTS.get('build', 'Release')
    target_arch = ARGUMENTS.get('arch', 'x64')
    
    # 验证参数
    valid_build_types = ['Debug', 'Release']
    valid_archs = ['ARM64', 'Win32', 'x64']
    
    if build_type not in valid_build_types:
        print(f"警告: 无效的构建类型 '{build_type}'，使用默认值 'Release'")
        build_type = 'Release'
    
    if target_arch not in valid_archs:
        print(f"警告: 无效的架构 '{target_arch}'，使用默认值 'x64'")
        target_arch = 'x64'
    
    print(f"构建配置:")
    print(f"  项目根目录: {project_root}")
    print(f"  构建类型: {build_type}")
    print(f"  目标架构: {target_arch}")
    print(f"  源文件目录: {src_dir}")
    print(f"  输出目录: {bin_dir}")
    
    # 构建前操作
    pre_build_actions()
    
    # 配置环境
    env = configure_environment(build_type, target_arch)
    
    # 构建依赖库
    scintilla_lib = build_scintilla(env, build_type, target_arch)
    lexilla_lib = build_lexilla(env, build_type, target_arch)
    
    # 构建主程序
    start_time = time.time()
    program = build_notepadabc(env, build_type, target_arch, scintilla_lib, lexilla_lib)
    
    # 构建后操作
    post_build_actions(build_type, target_arch)
    
    # 计算构建时间
    build_time = time.time() - start_time
    
    # 打印构建信息
    print("\n" + "=" * 70)
    print("构建完成!")
    print(f"构建类型: {build_type}")
    print(f"目标架构: {target_arch}")
    print(f"构建时间: {build_time:.2f} 秒")
    print(f"输出目录: {bin_dir}")
    print(f"构建时间: {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}")
    print("=" * 70)
    
    return program

