"""
简化的Notepad_abc SCons构建脚本
基于Visual Studio解决方案: E:\GitHub3\notepad_abc\PowerEditor\visual.net\notepadPlus.sln
快速构建版本，适合日常开发使用
"""

import os
import sys
import time
from datetime import datetime

# 项目根目录
project_root = Dir('.').abspath

# 重要目录路径
src_dir = os.path.join(project_root, 'PowerEditor', 'src')
bin_dir = os.path.join(project_root, 'bin')

# 确保输出目录存在
if not os.path.exists(bin_dir):
    os.makedirs(bin_dir)

# 构建环境配置
def configure_environment():
    """配置SCons构建环境"""
    
    # 获取构建参数
    build_type = ARGUMENTS.get('build', 'Release')
    target_arch = ARGUMENTS.get('arch', 'x86_64')
    
    # 创建环境
    env = Environment(
        ENV = os.environ,
        TARGET_ARCH = target_arch,
        MSVC_VERSION = '14.3'  # VS2022
    )
    
    # 设置编码为UTF-8
    env['ENV']['PYTHONIOENCODING'] = 'utf-8'
    
    # 编译器选项
    cxxflags = [
        '/std:c++20',           # C++20标准
        '/MP',                   # 多处理器编译
        '/W4',                   # 警告级别4
        '/WX',                   # 将警告视为错误
        '/Zc:wchar_t',           # wchar_t是本机类型
        '/Zc:forScope',          # 强制for循环范围
        '/Zc:inline',            # 移除未引用的函数
        '/permissive-',          # 严格标准一致性
        '/utf-8',                # UTF-8编码
    ]
    
    # 预处理器定义
    defines = [
        'WIN32',
        '_WINDOWS',
        'UNICODE',
        '_UNICODE',
        '_WIN32_WINNT=0x0601',   # Windows 7
        'WINVER=0x0601',         # Windows 7
        '_CRT_SECURE_NO_WARNINGS',
        '_SCL_SECURE_NO_WARNINGS',
        'NOMINMAX',
        'STRICT',
        'TIXML_USE_STL',
        'NOTEPADPLUS_VERSION="8.6.6"',
    ]
    
    # 根据构建类型调整
    if build_type == 'Debug':
        defines.extend(['DEBUG', '_DEBUG'])
        cxxflags.extend(['/Od', '/RTC1', '/ZI', '/JMC'])
    else:  # Release
        defines.extend(['NDEBUG'])
        cxxflags.extend(['/O2', '/Ob2', '/Oi', '/Ot', '/GL', '/Gy'])
    
    # 根据架构调整
    if target_arch == 'ARM64':
        cxxflags.append('/ARM64')
    elif target_arch == 'Win32':
        cxxflags.append('/arch:SSE2')
    elif target_arch == 'x86_64':
        cxxflags.append('/favor:AMD64')
    
    env.Append(CCFLAGS=cxxflags)
    env.Append(CPPDEFINES=defines)
    
    # 包含目录
    include_dirs = [
        src_dir,
        os.path.join(src_dir, 'TinyXml'),
        os.path.join(src_dir, 'TinyXml', 'tinyXmlA'),
        os.path.join(src_dir, 'uchardet'),
        os.path.join(src_dir, 'ScintillaComponent'),
        os.path.join(src_dir, 'MISC', 'Common'),
        os.path.join(project_root, 'scintilla', 'include'),
        os.path.join(project_root, 'lexilla', 'include'),
    ]
    
    # 添加WinControls子目录
    wincontrols_base = os.path.join(src_dir, 'WinControls')
    if os.path.exists(wincontrols_base):
        for item in os.listdir(wincontrols_base):
            item_path = os.path.join(wincontrols_base, item)
            if os.path.isdir(item_path):
                include_dirs.append(item_path)
    
    env.Append(CPPPATH=include_dirs)
    
    # 链接器选项
    linkflags = [
        '/MANIFEST',
        '/MANIFESTUAC:level=\'asInvoker\' uiAccess=\'false\'',
        '/DYNAMICBASE',
        '/NXCOMPAT',
        '/SUBSYSTEM:WINDOWS',
        '/OPT:REF',
        '/OPT:ICF',
    ]
    
    # 根据架构调整
    if target_arch == 'ARM64':
        linkflags.append('/MACHINE:ARM64')
    elif target_arch == 'Win32':
        linkflags.append('/MACHINE:X86')
    elif target_arch == 'x86_64':
        linkflags.append('/MACHINE:X64')
    
    if build_type == 'Debug':
        linkflags.extend(['/DEBUG', '/INCREMENTAL'])
    else:
        linkflags.append('/LTCG')
    
    env.Append(LINKFLAGS=linkflags)
    
    # 库文件
    libraries = [
        'kernel32.lib', 'user32.lib', 'gdi32.lib', 'winspool.lib',
        'comdlg32.lib', 'advapi32.lib', 'shell32.lib', 'ole32.lib',
        'oleaut32.lib', 'uuid.lib', 'odbc32.lib', 'odbccp32.lib',
        'comctl32.lib', 'shlwapi.lib', 'version.lib', 'imm32.lib',
        'winmm.lib', 'usp10.lib', 'dwmapi.lib',
    ]
    
    env.Append(LIBS=libraries)
    
    return env, build_type, target_arch

# 获取源文件列表
def get_source_files():
    """获取源文件列表"""
    
    source_files = []
    
    # 主要源文件列表
    main_files = [
        'Notepad_plus.cpp',
        'Notepad_plus_Window.cpp',
        'NppBigSwitch.cpp',
        'NppCommands.cpp',
        'NppNotification.cpp',
        'NppIO.cpp',
        'WinMain.cpp',
        'Parameters.cpp',
        'NppDarkMode.cpp',
        'dpiManagerV2.cpp',
        'Utf8_16.cpp',
        'EncodingMapper.cpp',
        'lastRecentFileList.cpp',
        'lesDlgs.cpp',
        'localization.cpp',
    ]
    
    # 添加主要源文件
    for file in main_files:
        full_path = os.path.join(src_dir, file)
        if os.path.exists(full_path):
            source_files.append(full_path)
    
    # 递归收集所有.cpp文件
    def collect_cpp_files(directory):
        """递归收集目录下的所有.cpp文件"""
        for root, dirs, files in os.walk(directory):
            for file in files:
                if file.endswith('.cpp'):
                    source_files.append(os.path.join(root, file))
    
    # 收集关键目录
    key_directories = [
        os.path.join(src_dir, 'TinyXml'),
        os.path.join(src_dir, 'MISC'),
        os.path.join(src_dir, 'ScintillaComponent'),
        os.path.join(src_dir, 'WinControls'),
        os.path.join(src_dir, 'uchardet'),
    ]
    
    for directory in key_directories:
        if os.path.exists(directory):
            collect_cpp_files(directory)
    
    return source_files

# 获取资源文件列表
def get_resource_files():
    """获取资源文件列表"""
    
    rc_files = []
    
    # 主要资源文件
    main_rc_files = [
        'Notepad_plus.rc',
        'localization.rc',
        'preference.rc',
        'shortcut.rc',
        'tabBar.rc',
        'TaskListDlg.rc',
    ]
    
    for rc_file in main_rc_files:
        full_path = os.path.join(src_dir, rc_file)
        if os.path.exists(full_path):
            rc_files.append(full_path)
    
    return rc_files

# 主构建函数
def main():
    """主构建函数"""
    
    print("=" * 60)
    print("Notepad_abc简化构建脚本")
    print("=" * 60)
    
    # 配置环境
    env, build_type, target_arch = configure_environment()
    
    print(f"构建配置:")
    print(f"  构建类型: {build_type}")
    print(f"  目标架构: {target_arch}")
    print(f"  源文件目录: {src_dir}")
    print(f"  输出目录: {bin_dir}")
    
    # 获取源文件和资源文件
    source_files = get_source_files()
    rc_files = get_resource_files()
    
    print(f"\n文件统计:")
    print(f"  源文件数量: {len(source_files)}")
    print(f"  资源文件数量: {len(rc_files)}")
    
    # 编译资源文件
    rc_objects = []
    for rc_file in rc_files:
        rc_obj = env.RES(rc_file)
        rc_objects.append(rc_obj)
    
    # 设置目标文件名
    target_name = 'notepad_abc.exe'
    
    # 开始构建
    print(f"\n开始构建 {target_name}...")
    start_time = time.time()
    
    program = env.Program(
        target=target_name,
        source=source_files + rc_objects
    )
    
    # 复制到输出目录
    env.Install(bin_dir, program)
    
    # 计算构建时间
    build_time = time.time() - start_time
    
    # 打印构建信息
    print("\n" + "=" * 60)
    print("构建完成!")
    print(f"构建类型: {build_type}")
    print(f"目标架构: {target_arch}")
    print(f"构建时间: {build_time:.2f} 秒")
    print(f"输出文件: {os.path.join(bin_dir, target_name)}")
    print(f"构建时间: {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}")
    print("=" * 60)
    
    return program

# 执行构建
if __name__ == '__main__':
    main()

# 默认目标
Default(main())