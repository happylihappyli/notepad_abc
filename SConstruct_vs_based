# 构建前操作
def pre_build_actions():
    """构建前操作"""
    
    # 执行版本头文件生成脚本
    version_script = os.path.join(src_dir, 'NppLibsVersionH-generator.bat')
    if os.path.exists(version_script):
        print("执行NppLibsVersionH-generator.bat生成版本头文件...")
        try:
            os.system(f'cd "{src_dir}" && "{version_script}"')
        except Exception as e:
            print(f"版本头文件生成失败: {e}")
    else:
        print(f"警告: 找不到版本生成脚本: {version_script}")

# 构建后操作
def post_build_actions(target, source, env, build_type, target_arch):
    """构建后操作"""
    
    # 复制配置文件
    config_files, config_dirs = get_config_files()
    
    for config_file in config_files:
        src_path = os.path.join(src_dir, config_file)
        if os.path.exists(src_path):
            dest_path = os.path.join(bin_dir, config_file)
            import shutil
            shutil.copy2(src_path, dest_path)
            print(f"复制配置文件: {config_file}")
    
    for config_dir in config_dirs:
        src_path = os.path.join(src_dir, config_dir)
        if os.path.exists(src_path):
            dest_path = os.path.join(bin_dir, config_dir)
            import shutil
            if os.path.exists(dest_path):
                shutil.rmtree(dest_path)
            shutil.copytree(src_path, dest_path)
            print(f"复制配置目录: {config_dir}")
    
    # 打印构建信息
    print(f"\n构建完成: {target[0].path}")
    print(f"构建类型: {build_type}")
    print(f"目标架构: {target_arch}")
    print(f"构建时间: {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}")
    
    # 文件大小信息
    target_size = os.path.getsize(target[0].path)
    print(f"输出文件大小: {target_size:,} 字节 ({target_size/1024/1024:.2f} MB)")

# 主构建函数
def main():
    """主构建函数"""
    
    print("=" * 60)
    print("基于Visual Studio解决方案的Notepad_abc构建脚本")
    print("=" * 60)
    
    # 配置环境
    env, build_type, target_arch = configure_environment()
    
    print(f"构建配置:")
    print(f"  项目根目录: {project_root}")
    print(f"  构建类型: {build_type}")
    print(f"  目标架构: {target_arch}")
    print(f"  源文件目录: {src_dir}")
    print(f"  输出目录: {bin_dir}")
    
    # 构建前操作
    pre_build_actions()
    
    # 获取源文件和资源文件
    source_files = get_source_files()
    rc_files = get_resource_files()
    
    print(f"\n文件统计:")
    print(f"  源文件数量: {len(source_files)}")
    print(f"  资源文件数量: {len(rc_files)}")
    
    # 编译资源文件
    rc_objects = []
    for rc_file in rc_files:
        if os.path.exists(rc_file):
            rc_obj = env.RES(rc_file)
            rc_objects.append(rc_obj)
    
    # 设置目标文件名
    target_name = 'notepad_abc.exe'
    
    # 构建程序
    print(f"\n开始构建 {target_name}...")
    start_time = time.time()
    
    program = env.Program(
        target=target_name,
        source=source_files + rc_objects
    )
    
    # 添加构建后操作
    env.AddPostAction(program, lambda target, source, env: 
        post_build_actions(target, source, env, build_type, target_arch))
    
    # 计算构建时间
    build_time = time.time() - start_time
    print(f"构建耗时: {build_time:.2f} 秒")
    
    return program

# 执行构建
if __name__ == '__main__':
    main()

# 默认目标
Default(main())