#include <windows.h>
#include "resource.h"

#ifndef IDC_STATIC
#define IDC_STATIC -1
#endif

IDD_TOMATO_TIMER DIALOGEX 0, 0, 300, 380
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
CAPTION "番茄工作法设置"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "工作时间(分钟):",IDC_STATIC,10,10,100,14
    EDITTEXT        IDC_WORK_MINUTES,120,10,50,14,ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "短休息时间(分钟):",IDC_STATIC,10,30,100,14
    EDITTEXT        IDC_SHORT_REST_MINUTES,120,30,50,14,ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "长休息时间(分钟):",IDC_STATIC,10,50,100,14
    EDITTEXT        IDC_LONG_REST_MINUTES,120,50,50,14,ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "长休息周期(番茄钟数):",IDC_STATIC,10,70,100,14
    EDITTEXT        IDC_LONG_REST_AFTER_POMODOROS,120,70,50,14,ES_AUTOHSCROLL | ES_NUMBER
    CHECKBOX        "启用TTS声音",IDC_ENABLE_TTS,10,90,120,14
    LTEXT           "短休息提醒文本:",IDC_STATIC,10,110,80,14
    EDITTEXT        IDC_SHORT_REST_REMINDER_TEXT,10,125,270,30,ES_AUTOHSCROLL | ES_MULTILINE | ES_WANTRETURN
    LTEXT           "长休息提醒文本:",IDC_STATIC,10,160,80,14
    EDITTEXT        IDC_LONG_REST_REMINDER_TEXT,10,175,270,30,ES_AUTOHSCROLL | ES_MULTILINE | ES_WANTRETURN
    LTEXT           "工作提醒文本:",IDC_STATIC,10,210,80,14
    EDITTEXT        IDC_WORK_REMINDER_TEXT,10,225,270,30,ES_AUTOHSCROLL | ES_MULTILINE | ES_WANTRETURN
    LTEXT           "定时器状态:",IDC_STATIC,10,260,80,14
    LTEXT           "空闲",IDC_TIMER_STATE,100,260,150,14
    LTEXT           "已完成番茄钟:",IDC_STATIC,10,280,80,14
    LTEXT           "0",IDC_POMODORO_COUNT,100,280,150,14
    LTEXT           "剩余时间:",IDC_STATIC,10,300,80,14
    LTEXT           "25:00",IDC_REMAINING_TIME,100,300,150,14
    PUSHBUTTON      "开始",IDC_START_TIMER,10,320,70,24
    PUSHBUTTON      "暂停",IDC_PAUSE_TIMER,90,320,70,24
    PUSHBUTTON      "停止",IDC_STOP_TIMER,170,320,70,24
    PUSHBUTTON      "测试TTS",IDC_TEST_TTS,250,320,40,24
    DEFPUSHBUTTON   "确定",IDOK,10,350,70,24
    PUSHBUTTON      "取消",IDCANCEL,90,350,70,24
    PUSHBUTTON      "重置番茄钟",IDC_RESET_POMODOROS,170,350,70,24
END
