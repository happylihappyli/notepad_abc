#include <windows.h>
#include "VerticalFileSwitcher_rc.h"

// UTF-8 BOM

#ifndef IDC_STATIC
#define IDC_STATIC -1
#endif

IDD_DOCLIST_SETTINGS DIALOGEX 0, 0, 470, 260
STYLE DS_SETFONT | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "文档列表设置"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    // 字体大小设置区域
    LTEXT           "当前字体大小:",IDC_FONTSIZE_DISPLAY,5,5,70,15,SS_LEFT
    CONTROL         "",IDC_FONTSIZE_SLIDER,"msctls_trackbar32",TBS_BOTH | TBS_NOTICKS | WS_VISIBLE | WS_TABSTOP,220,5,220,20
    
    // 分类管理区域
    LTEXT           "文件分类管理:",10,5,40,80,15,SS_LEFT
    CONTROL         "",IDC_CATEGORY_LIST,"LISTBOX",LBS_STANDARD | LBS_HASSTRINGS | LBS_NOTIFY | WS_VSCROLL | WS_TABSTOP,5,60,280,120
    
    PUSHBUTTON      "添加分类",IDC_ADD_CATEGORY,300,60,80,25
    PUSHBUTTON      "删除分类",IDC_DELETE_CATEGORY,300,90,80,25
    PUSHBUTTON      "重命名分类",IDC_RENAME_CATEGORY,300,120,80,25
    
    // 按钮区域
    PUSHBUTTON      "确定",IDOK,280,200,70,25
    PUSHBUTTON      "取消",IDCANCEL,360,200,70,25
END

IDD_DOCLIST DIALOGEX 26, 41, 230, 370
STYLE DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_TOOLWINDOW | WS_EX_WINDOWEDGE
CAPTION "Document List"
FONT 8, "MS Sans Serif", 0, 0, 0x0
BEGIN
	CONTROL         "",IDC_LIST_DOCLIST,"SysListView32",LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_CHILD | WS_VISIBLE | WS_BORDER | WS_TABSTOP,0,0,230,370
END